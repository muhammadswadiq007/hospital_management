<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shows as a "Hospital" role dropdown on each user's form (Settings > Users) -->
    <record id="res_groups_privilege_hms" model="res.groups.privilege">
        <field name="name">Hospital</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <!-- Each role includes everything the role above it can do -->
    <record id="group_hms_receptionist" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_hms"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Registers patients and books appointments. No access to clinical notes.</field>
    </record>

    <record id="group_hms_nurse" model="res.groups">
        <field name="name">Nurse</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_hms"/>
        <field name="implied_ids" eval="[(4, ref('group_hms_receptionist'))]"/>
        <field name="comment">Can read all encounters (visits).</field>
    </record>

    <record id="group_hms_doctor" model="res.groups">
        <field name="name">Doctor</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_hms"/>
        <field name="implied_ids" eval="[(4, ref('group_hms_nurse'))]"/>
        <field name="comment">Can create and edit their OWN encounters only.</field>
    </record>

    <record id="res_groups_privilege_hms_lab" model="res.groups.privilege">
        <field name="name">Hospital Laboratory</field>
        <field name="sequence">11</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_hms_lab" model="res.groups">
        <field name="name">Lab Technician</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_hms_lab"/>
        <field name="implied_ids" eval="[(4, ref('group_hms_receptionist'))]"/>
        <field name="comment">Works the lab worklist and releases results. No access to clinical notes, diagnoses or prescriptions.</field>
    </record>

    <record id="res_groups_privilege_hms_billing" model="res.groups.privilege">
        <field name="name">Hospital Billing</field>
        <field name="sequence">12</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_hms_cashier" model="res.groups">
        <field name="name">Cashier</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_hms_billing"/>
        <field name="implied_ids" eval="[(4, ref('group_hms_receptionist')), (4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Invoices finished visits and takes payments. Cannot see clinical notes, vitals, diagnoses or lab results.</field>
    </record>

    <record id="group_hms_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_hms"/>
        <field name="implied_ids" eval="[(4, ref('group_hms_doctor')), (4, ref('group_hms_lab')), (4, ref('group_hms_cashier'))]"/>
        <field name="comment">Full access, including practitioners and deleting records.</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
