<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hms_appointment_list" model="ir.ui.view">
        <field name="name">hms.appointment.list</field>
        <field name="model">hms.appointment</field>
        <field name="arch" type="xml">
            <list decoration-muted="status in ('cancelled', 'noshow')" decoration-success="status == 'fulfilled'">
                <field name="name"/>
                <field name="start"/>
                <field name="patient_id"/>
                <field name="practitioner_id"/>
                <field name="reason"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hms_appointment_form" model="ir.ui.view">
        <field name="name">hms.appointment.form</field>
        <field name="model">hms.appointment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_arrive" string="Check In" type="object" class="btn-primary"
                            invisible="status != 'booked'"/>
                    <button name="action_noshow" string="No Show" type="object"
                            invisible="status != 'booked'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="status != 'booked'"/>
                    <field name="status" widget="statusbar" statusbar_visible="booked,arrived,fulfilled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id" readonly="status != 'booked'"/>
                            <field name="practitioner_id" readonly="status != 'booked'"/>
                            <field name="reason"/>
                        </group>
                        <group>
                            <field name="start" readonly="status != 'booked'"/>
                            <field name="end" readonly="status != 'booked'"/>
                            <field name="encounter_id" invisible="not encounter_id"
                                   groups="hospital_management.group_hms_nurse"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hms_appointment_calendar" model="ir.ui.view">
        <field name="name">hms.appointment.calendar</field>
        <field name="model">hms.appointment</field>
        <field name="arch" type="xml">
            <calendar date_start="start" date_stop="end" color="practitioner_id" mode="week">
                <field name="patient_id"/>
                <field name="practitioner_id" filters="1"/>
                <field name="status"/>
            </calendar>
        </field>
    </record>

    <record id="view_hms_appointment_search" model="ir.ui.view">
        <field name="name">hms.appointment.search</field>
        <field name="model">hms.appointment</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id"/>
                <field name="practitioner_id"/>
                <field name="name"/>
                <filter name="booked" string="Booked" domain="[('status', '=', 'booked')]"/>
                <filter name="today" string="Today"
                        domain="[('start', '&gt;=', 'today'), ('start', '&lt;', 'today +1d')]"/>
                <group>
                    <filter name="group_practitioner" string="Practitioner" context="{'group_by': 'practitioner_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hms_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">hms.appointment</field>
        <field name="view_mode">list,calendar,form</field>
    </record>
</odoo>
