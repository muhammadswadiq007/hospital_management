<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hms_practitioner_list" model="ir.ui.view">
        <field name="name">hms.practitioner.list</field>
        <field name="model">hms.practitioner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="role"/>
                <field name="specialty"/>
                <field name="license_number"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_hms_practitioner_form" model="ir.ui.view">
        <field name="name">hms.practitioner.form</field>
        <field name="model">hms.practitioner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Dr. Amina Otieno"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="role"/>
                            <field name="specialty"/>
                            <field name="license_number"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hms_practitioner" model="ir.actions.act_window">
        <field name="name">Practitioners</field>
        <field name="res_model">hms.practitioner</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
