<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_hms_patient" model="ir.sequence">
            <field name="name">Patient MRN</field>
            <field name="code">hms.patient</field>
            <field name="prefix">MRN/%(year)s/</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_hms_appointment" model="ir.sequence">
            <field name="name">Appointment</field>
            <field name="code">hms.appointment</field>
            <field name="prefix">APT/%(year)s/</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_hms_encounter" model="ir.sequence">
            <field name="name">Encounter</field>
            <field name="code">hms.encounter</field>
            <field name="prefix">ENC/%(year)s/</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_hms_lab_request" model="ir.sequence">
            <field name="name">Lab Request</field>
            <field name="code">hms.lab.request</field>
            <field name="prefix">LAB/%(year)s/</field>
            <field name="padding">5</field>
        </record>
    </data>
</odoo>
